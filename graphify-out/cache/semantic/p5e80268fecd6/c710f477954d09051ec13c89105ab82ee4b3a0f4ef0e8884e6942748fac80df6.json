{"nodes": [{"id": "docs_economia_tokens", "label": "ECONOMIA-TOKENS.md \u2014 Econom\u00eda de tokens", "file_type": "document", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El contexto es el recurso m\u00e1s escaso: un contexto lleno de ruido degrada la calidad del modelo ANTES de agotarse, as\u00ed que ahorrar tokens optimiza coste y rendimiento a la vez. Se renombr\u00f3 desde TOKENS.md para escapar del filtro de sensibles de graphify."}, {"id": "docs_economia_tokens_jerarquia_coste", "label": "Jerarqu\u00eda de coste de las operaciones", "file_type": "concept", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nunca pagues el nivel N si el N\u22121 responde la pregunta; el nivel del grafo no sustituye a leer el fragmento exacto para editar, su ganancia est\u00e1 en la fase de orientaci\u00f3n, que es donde se dilapida el contexto."}, {"id": "docs_economia_tokens_subagentes_cortafuegos", "label": "Subagentes como cortafuegos de contexto", "file_type": "concept", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una b\u00fasqueda amplia hecha por `scout` quema el contexto DEL SCOUT y devuelve 20 l\u00edneas; hecha por ti, mete 5.000 l\u00edneas de dumps en el contexto principal."}, {"id": "docs_economia_tokens_prompt_caching", "label": "Prompt caching", "file_type": "concept", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La cach\u00e9 se invalida al cambiar el PREFIJO del contexto, por eso conviene no editar CLAUDE.md ni la configuraci\u00f3n entre turnos de una misma sesi\u00f3n."}, {"id": "docs_economia_tokens_supervivencia_compactacion", "label": "Supervivencia a la compactaci\u00f3n", "file_type": "concept", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "En sesiones largas el contexto se compacta y los detalles se pierden: el estado durable debe vivir en archivos, no en la conversaci\u00f3n."}], "edges": [{"source": "docs_economia_tokens_subagentes_cortafuegos", "target": "agent_scout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "weight": 1}, {"source": "docs_economia_tokens", "target": "docs_economia_tokens_jerarquia_coste", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "weight": 1}, {"source": "docs_economia_tokens", "target": "docs_economia_tokens_subagentes_cortafuegos", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "weight": 1}, {"source": "docs_economia_tokens", "target": "docs_economia_tokens_prompt_caching", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "weight": 1}, {"source": "docs_economia_tokens", "target": "docs_economia_tokens_supervivencia_compactacion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "weight": 1}, {"source": "docs_economia_tokens", "target": "skill_optimize_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "weight": 1}, {"source": "docs_economia_tokens_jerarquia_coste", "target": "docs_graphify", "relation": "references", "confidence": "EXTRACTED", "confidence_scor