{"nodes": [{"id": "skill_graphify", "label": "graphify skill", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "claude_skills_graphify_skill", "label": "graphify skill", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fast path: si graphify-out/graph.json ya existe y la petici\u00f3n es una pregunta en lenguaje natural, salta directo a query en vez de reconstruir"}, {"id": "claude_skills_graphify_skill", "label": "graphify SKILL.md (main pipeline)", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "claude_skills_graphify_skill_shrink_guard", "label": "graph.json shrink-guard (#479)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json refuses to write graph.json when the new graph has fewer nodes than the existing one, so GRAPH_REPORT.md and the analysis sidecar never describe a graph smaller than what graph.json actually holds; an empty extraction must not clobber a good graph."}, {"id": "claude_skills_graphify_skill_manifest_stamping", "label": "Selective manifest stamping (#2015)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only semantic files (docs/papers/images) that actually produced chunk output get stamped in the manifest; a file whose chunk failed or was omitted stays unstamped so --update re-queues it instead of marking it done and losing its content forever. Code files are always stamped since AST extraction is deterministic."}, {"id": "claude_skills_graphify_skill_semantic_hash_clear", "label": "Stale semantic_hash clearing (#1948)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Files dispatched this run but not stamped still carry a stale semantic_hash from a prior run; clearing it forces detect_incremental to re-queue them instead of reading them as unchanged."}, {"id": "claude_skills_graphify_skill_root_relativization", "label": "root= relativization for manifest/build parity (#1361)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manifest keys and node keys are relativized to the same scan root as the build, so a later --update matches cached files instead of missing every one, and the on-disk manifest stays portable across clones/machines."}, {"id": "claude_skills_graphify_skill_cache_prompt_stamp", "label": "Semantic cache stamped by prompt (#1939)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "save_semantic_cache is passed the same SPEC_PATH used to read the cache; a write under a different prompt than the read lands where the next run won't look for it."}, {"id": "claude_skills_graphify_skill_scan_corpus_guard", "label": "Raw scan_corpus vs stamp-filtered subset (#1908)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "save_manifest uses the raw full corpus (not the stamp-filtered 