{"nodes": [{"id": "_claude_skills_graphify_references_update_update_reference", "label": "graphify Incremental Update and Cluster-Only Reference", "file_type": "document", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_update_detect_incremental", "label": "detect_incremental", "file_type": "code", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_update_build_merge", "label": "build_merge", "file_type": "code", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_update_replace_on_reextract", "label": "Replace-on-re-extract", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every source_file present in the new chunks is dropped from the base before merging, so changed files reconcile without stale nodes surviving (#1344)."}, {"id": "_claude_skills_graphify_references_update_prune_sources_deletions_only", "label": "prune_sources is for deleted files only", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding changed files to prune_sources would delete the freshly re-extracted content, since root= relativizes prune paths to the same base as the merged nodes."}, {"id": "_claude_skills_graphify_references_update_root_relativization", "label": "root= path relativization on merge", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without root=, absolute paths from detect_incremental never match the graph's relative source_file values, nothing is pruned and stale nodes accumulate (#1361)."}, {"id": "_claude_skills_graphify_references_update_directed_flag_propagation", "label": "directed flag must be propagated to update", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A --directed --update without it silently rebuilds undirected and collapses reciprocal A<->B edges (#1392)."}, {"id": "_claude_skills_graphify_references_update_code_only_fast_path", "label": "Code-only change fast path", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If every changed file is code, only AST extraction runs and semantic subagents are skipped entirely \u2014 no LLM cost."}, {"id": "_claude_skills_graphify_references_update_video_to_document_rewrite", "label": "Rewrite video paths to transcripts before dispatch", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Otherwise raw .mp4/.mp3 paths are handed to semantic subagents as unreadable media (#1392)."}, {"id": "_claude_skills_graphify_references_update_manifest_stamping", "label": "Selective manifest stamping", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only semantic files that actually produced output this run are stamped; a failed chunk must stay unstamped so the next update re-queues it instead of losing its content forever (#2015)."}, {"id": "_claude_skills_graphify_references_update_scan_corpus_exclusions", "label": "scan_corpus of the raw full corpus", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passing the raw corpus lets newly excluded in-root files be dropped rather than masquerading as deletions, while untouched rows are preserved (#1908)."}, {"id": "_claude_skills_graphify_references_update_deletions_only_empty_extraction", "label": "Empty extraction for deletion-only runs", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The merge step still needs an extraction file to prune against when nothing new was added."}, {"id": "_claude_skills_graphify_references_update_graph_diff_report", "label": "graph_diff post-update report", "file_type": "code", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_update_cluster_only", "label": "cluster-only re-clustering", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify cluster-only is self-contained; re-running steps 5-9 raises FileNotFoundError because a prior build's cleanup deleted the intermediate files (#1392)."}], "edges": [{"source": "_claude_skills_graphify_references_update_update_reference", "target": "_claude_skills_g