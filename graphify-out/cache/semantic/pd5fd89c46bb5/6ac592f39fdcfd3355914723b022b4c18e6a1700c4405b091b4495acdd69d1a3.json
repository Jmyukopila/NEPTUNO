{"nodes": [{"id": "_claude_skills_eda_skill_eda", "label": "Skill /eda \u2014 an\u00e1lisis exploratorio", "file_type": "document", "source_file": ".claude/skills/eda/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El entregable es un script/notebook reproducible m\u00e1s un reporte donde CADA afirmaci\u00f3n lleva su n\u00famero."}, {"id": "_claude_skills_eda_skill_defensive_load", "label": "Carga defensiva del dataset", "file_type": "rationale", "source_file": ".claude/skills/eda/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un read_csv a ciegas produce datos silenciosamente corruptos; los IDs como int pierden los ceros a la izquierda. Inspeccionar el archivo crudo antes de parsearlo."}, {"id": "_claude_skills_eda_skill_column_profile", "label": "Perfil por columna", "file_type": "rationale", "source_file": ".claude/skills/eda/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se presenta como tabla, no como prosa: tipos, nulos, cardinalidad, valores-centinela ('N/A','-','999') y fechas epoch-basura."}, {"id": "_claude_skills_eda_skill_integrity_checks", "label": "Integridad y clave candidata", "file_type": "rationale", "source_file": ".claude/skills/eda/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El 'ID \u00fanico' duplicado es el hallazgo m\u00e1s com\u00fan del EDA; hay que verificar la unicidad de la clave candidata en vez de asumirla."}, {"id": "_claude_skills_eda_skill_distributions_and_relations", "label": "Distribuciones y relaciones", "file_type": "rationale", "source_file": ".claude/skills/eda/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo las correlaciones que importan a la pregunta de negocio, no la matriz completa por decorar; en series temporales buscar cambios de r\u00e9gimen (\u00bfcambi\u00f3 la definici\u00f3n del dato?)."}, {"id": "_claude_skills_eda_skill_evidence_rule", "label": "Regla de evidencia num\u00e9rica", "file_type": "rationale", "source_file": ".claude/skills/eda/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Hay muchos nulos' est\u00e1 prohibido; '34% de nulos en email (12.403/36.480)' es lo aceptable."}, {"id": "_claude_skills_eda_skill_describe_dont_clean", "label": "El EDA describe, no limpia", "file_type": "rationale", "source_file": ".claude/skills/eda/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No imputar, no eliminar outliers: hay que distinguir 'el dato es raro' (error de captura) de 'el dato es inc\u00f3modo' (real pero inesperado), y las decisiones de limpieza se toman despu\u00e9s y quedan documentadas."}], "edges": [{"source": "_claude_skills_eda_skill_eda", "target": "_claude_skills_eda_skill_defensive_load", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/eda/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_eda_skill_eda", "target": "_claude_skills_eda_skill_column_profile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/eda/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_eda_skill_eda", "target": "_claude_skills_eda_skill_integrity_checks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/eda/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_eda_skill_eda", "target": "_claude_skills_eda_skill_distributions_and_relations", "relation": "references"