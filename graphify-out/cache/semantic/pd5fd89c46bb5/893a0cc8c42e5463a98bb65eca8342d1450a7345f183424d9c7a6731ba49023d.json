{"nodes": [{"id": "_claude_skills_sql_optimize_skill_sql_optimize_skill", "label": "sql-optimize skill", "file_type": "document", "source_file": ".claude/skills/sql-optimize/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_sql_optimize_skill_measure_dont_guess", "label": "Measure, do not guess", "file_type": "rationale", "source_file": ".claude/skills/sql-optimize/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No optimization without an EXPLAIN before and a measurement after \u2014 intuition about SQL performance is wrong more often than right, and a fast query over 100 dev rows says nothing about 10M in production."}, {"id": "_claude_skills_sql_optimize_skill_plan_suspects", "label": "Usual plan suspects", "file_type": "rationale", "source_file": ".claude/skills/sql-optimize/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seq scan on a large table with a selective filter, an unused index due to a function or implicit cast or leading wildcard, estimates off by 100x from stale statistics, nested loop over millions of rows, sort spilling to disk."}, {"id": "_claude_skills_sql_optimize_skill_n_plus_one", "label": "Application-level N+1", "file_type": "rationale", "source_file": ".claude/skills/sql-optimize/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The query is fast but runs 500 times \u2014 the fix belongs in the code (JOIN/IN/dataloader), not in SQL."}, {"id": "_claude_skills_sql_optimize_skill_one_improvement_at_a_time", "label": "One improvement at a time, cheapest first", "file_type": "rationale", "source_file": ".claude/skills/sql-optimize/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Statistics first (free), then sargable rewriting, then a new index, and structural changes only with evidence that the first three were not enough."}, {"id": "_claude_skills_sql_optimize_skill_index_write_cost", "label": "Index write cost", "file_type": "rationale", "source_file": ".claude/skills/sql-optimize/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every index speeds reads and taxes all writes to the table, so each one must be justified and redundant existing indexes retired."}, {"id": "_claude_skills_sql_optimize_skill_semantic_equivalence_check", "label": "Semantic equivalence check after rewriting", "file_type": "rationale", "source_file": ".claude/skills/sql-optimize/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rewritten JOIN can duplicate rows and NULLs break NOT IN, so the same count and a checksum over a sample must still match."}], "edges": [{"source": "_claude_skills_sql_optimize_skill_sql_optimize_skill", "target": "_claude_skills_sql_optimize_skill_measure_dont_guess", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/sql-optimize/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_sql_optimize_skill_measure_dont_guess", "target": "_claude_skills_sql_optimize_skill_plan_suspects", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/sql-optimize/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_sql_optimize_skill_plan_suspects", "target": "_claude_skills_sql_optimize_skill_n_plus_one", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/sql-optimize/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_sql