{"nodes": [{"id": "_claude_skills_desktop_release_skill_desktop_release", "label": "Skill /desktop-release", "file_type": "document", "source_file": ".claude/skills/desktop-release/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un release sin verificar el artefacto generado (existe, tamano plausible, arranca) es un release a medias."}, {"id": "_claude_skills_desktop_release_skill_version_bump", "label": "Bump de versi\u00f3n Electron/Tauri", "file_type": "rationale", "source_file": ".claude/skills/desktop-release/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tauri declara la versi\u00f3n en tauri.conf.json y/o Cargo.toml; una discrepancia entre ambos produce instaladores con el n\u00famero equivocado sin ning\u00fan error visible, el bug de versi\u00f3n m\u00e1s frecuente en Tauri."}, {"id": "_claude_skills_desktop_release_skill_code_signing_windows", "label": "Firma de c\u00f3digo en Windows", "file_type": "rationale", "source_file": ".claude/skills/desktop-release/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin CSC_LINK (Electron) o certificateThumbprint (Tauri) el bundler no firma y tampoco falla el build: es un aviso, no un fallo. Nunca se asume la firma; sin certificado el release sigue siendo v\u00e1lido pero se declara sin firmar."}, {"id": "_claude_skills_desktop_release_skill_installer_verification", "label": "Verificaci\u00f3n del instalador generado", "file_type": "rationale", "source_file": ".claude/skills/desktop-release/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El paso que todos se saltan: comprobar existencia, tama\u00f1o plausible e instalaci\u00f3n silenciosa. Si no es viable de forma no interactiva, se declara PARCIAL en vez de darla por buena sin evidencia."}, {"id": "_claude_skills_desktop_release_skill_secrets_never_hardcoded", "label": "Secretos de firma fuera del repo", "file_type": "rationale", "source_file": ".claude/skills/desktop-release/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Certificados y contrase\u00f1as jam\u00e1s hardcodeados en config versionada ni en el reporte; siempre por variable de entorno o gestor de secretos externo."}], "edges": [{"source": "_claude_skills_desktop_release_skill_desktop_release", "target": "_claude_skills_desktop_release_skill_version_bump", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/desktop-release/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_desktop_release_skill_desktop_release", "target": "_claude_skills_desktop_release_skill_code_signing_windows", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/desktop-release/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_desktop_release_skill_desktop_release", "target": "_claude_skills_desktop_release_skill_installer_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/desktop-release/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_desktop_release_skill_desktop_release", "target": "_claude_skills_desktop_release_skill_secrets_never_hardcoded", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/desktop-release/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_desktop_release_skill_desktop_release", "target": "_claude_skills_desktop_run_skill_desktop_run", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95