{"nodes": [{"id": "_claude_skills_parallel_split_skill_parallel_split_skill", "label": "parallel-split skill", "file_type": "document", "source_file": ".claude/skills/parallel-split/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_parallel_split_skill_independent_decomposition", "label": "Independent, non-overlapping decomposition", "file_type": "rationale", "source_file": ".claude/skills/parallel-split/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subtasks must not need each other's output and must not touch the same files \u2014 two agents editing one file is a guaranteed conflict, so such subtasks are merged."}, {"id": "_claude_skills_parallel_split_skill_agent_assignment", "label": "Agent assignment by task kind", "file_type": "rationale", "source_file": ".claude/skills/parallel-split/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search to scout (cheap Haiku), design to architect (Opus), implementation to implementer, verification to verifier."}, {"id": "_claude_skills_parallel_split_skill_cold_start_prompt", "label": "Cold-start subagent prompt", "file_type": "rationale", "source_file": ".claude/skills/parallel-split/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The subagent begins without this conversation, so each brief must carry project context, exact files, success criteria, forbidden files and the report format."}, {"id": "_claude_skills_parallel_split_skill_critical_integration", "label": "Critical integration of results", "file_type": "rationale", "source_file": ".claude/skills/parallel-split/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subage