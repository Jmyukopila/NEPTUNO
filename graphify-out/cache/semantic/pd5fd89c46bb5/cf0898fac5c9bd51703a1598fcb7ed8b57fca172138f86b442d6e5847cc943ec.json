{"nodes": [{"id": "_claude_skills_pr_merge_skill_pr_merge_skill", "label": "pr-merge skill", "file_type": "document", "source_file": ".claude/skills/pr-merge/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_pr_merge_skill_three_green_lights", "label": "Three green lights before merge", "file_type": "rationale", "source_file": ".claude/skills/pr-merge/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks, reviews and mergeability must all be green; a red check is never merged 'because the failure looks unrelated'."}, {"id": "_claude_skills_pr_merge_skill_conflict_resolution", "label": "Conflict resolution by rebase onto base", "file_type": "rationale", "source_file": ".claude/skills/pr-merge/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both sides are read before resolving \u2014 never 'accept all mine' \u2014 and rewritten shared history is pushed with --force-with-lease, never --force."}, {"id": "_claude_skills_pr_merge_skill_merge_strategy_from_repo", "label": "Merge strategy taken from the repo", "file_type": "rationale", "source_file": ".claude/skills/pr-merge/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Squash by default for work branches with process commits, merge commit or rebase only if that is the repo's convention."}, {"id": "_claude_skills_pr_merge_skill_no_admin_override", "label": "Never use --admin on your own initiative", "file_type": "rationale", "source_file": ".claude/skills/pr-merge/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_pr_merge_skill_post_merge_stack_warning", "label": "Post-merge stack warning", "file_type": "rational