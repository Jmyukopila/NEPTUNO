{"nodes": [{"id": "_claude_skills_ml_experiment_skill_ml_experiment_skill", "label": "ml-experiment skill", "file_type": "document", "source_file": ".claude/skills/ml-experiment/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_ml_experiment_skill_data_leakage", "label": "Data leakage", "file_type": "rationale", "source_file": ".claude/skills/ml-experiment/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The enemy of the whole protocol: it produces spectacular development metrics and useless production models, which is why steps 1-3 close before any training."}, {"id": "_claude_skills_ml_experiment_skill_split_before_looking", "label": "Split before looking at the data", "file_type": "rationale", "source_file": ".claude/skills/ml-experiment/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The test set is set aside before any analysis or feature engineering and touched once; a random split on time series is structural leakage, and repeated entities need a group split."}, {"id": "_claude_skills_ml_experiment_skill_baseline_first", "label": "Baseline first", "file_type": "rationale", "source_file": ".claude/skills/ml-experiment/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every later model must justify itself only by improvement over a trivial and a simple baseline; an XGBoost that beats chance but not logistic regression is complexity without value."}, {"id": "_claude_skills_ml_experiment_skill_primary_metric", "label": "Single primary metric chosen by error cost", "file_type": "rationale", "source_file": ".claude/skills/ml-experiment/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accuracy on imbalanced classes is banned as a primary metric because it hides the error that actually costs money."}, {"id": "_claude_skills_ml_experiment_skill_leak_free_features", "label": "Leak-free feature construction", "file_type": "rationale", "source_file": ".claude/skills/ml-experiment/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every feature must have existed with that content at prediction time; scalers, imputers and target encodings are fit inside the train fold only."}, {"id": "_claude_skills_ml_experiment_skill_error_analysis", "label": "Mandatory error analysis", "file_type": "rationale", "source_file": ".claude/skills/ml-experiment/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inspecting 20-30 concrete errors for a systematic failing segment is worth more than a decimal of metric."}, {"id": "_claude_skills_ml_experiment_skill_leakage_alarm_signals", "label": "Leakage alarm signals", "file_type": "rationale", "source_file": ".claude/skills/ml-experiment/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Suspiciously good validation, val >> test, or one feature owning 90% of importance mean stop and hunt the leak."}], "edges": [{"source": "_claude_skills_ml_experiment_skill_ml_experiment_skill", "target": "_claude_skills_ml_experiment_skill_data_leakage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/ml-experiment/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_ml_experiment_skill_split_before_looking", "target": "_claude_skills_ml_experiment_skill_data_leakage", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/ml-experiment/SKILL.md"