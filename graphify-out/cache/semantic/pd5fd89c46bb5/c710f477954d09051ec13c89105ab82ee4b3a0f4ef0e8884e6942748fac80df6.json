{"nodes": [{"id": "docs_economia_tokens_economia_tokens", "label": "Econom\u00eda de tokens", "file_type": "document", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": "L1-L51", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_economia_tokens_cost_hierarchy", "label": "Jerarqu\u00eda de coste de las operaciones", "file_type": "rationale", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nunca pagues el nivel N si el N-1 responde la pregunta; el grafo (nivel 2) dice d\u00f3nde mirar pero nunca es evidencia suficiente para escribir un Edit."}, {"id": "docs_economia_tokens_subagents_as_context_firewall", "label": "Subagentes como cortafuegos de contexto", "file_type": "rationale", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una b\u00fasqueda amplia hecha por el agente scout quema el contexto DEL SCOUT y devuelve 20 l\u00edneas; hecha por ti mete 5000 l\u00edneas de dumps."}, {"id": "docs_economia_tokens_compaction_survival", "label": "Supervivencia a la compactaci\u00f3n", "file_type": "rationale", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "En sesiones largas el contexto se compacta y los detalles se pierden: el estado durable va a archivos (NOTES.md/HANDOFF.md), no a la conversaci\u00f3n."}, {"id": "docs_economia_tokens_prompt_caching", "label": "Prompt caching", "file_type": "rationale", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La cach\u00e9 se invalida al cambiar el prefijo del contexto, as\u00ed que CLAUDE.md y la configuraci\u00f3n se mantienen estables durante la sesi\u00f3n y se prefieren r\u00e1fagas de trabajo al goteo espaciado."}, {"id": "docs_economia_tokens_model_selection_by_task", "label": "Elegir el modelo por tarea", "file_type": "rationale", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El modelo caro en la decisi\u00f3n y el barato en el volumen: usar Opus para greps o Haiku para dise\u00f1o es el anti-patr\u00f3n."}, {"id": "docs_economia_tokens_output_budget", "label": "Presupuesto de salida", "file_type": "concept", "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_economia_tokens_economia_tokens", "target": "docs_economia_tokens_cost_hierarchy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "weight": 1.0}, {"source": "docs_economia_tokens_economia_tokens", "target": "docs_economia_tokens_subagents_as_context_firewall", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "weight": 1.0}, {"source": "docs_economia_tokens_economia_tokens", "target": "docs_economia_tokens_compaction_survival", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "weight": 1.0}, {"source": "docs_economia_tokens_economia_tokens", "target": "docs_economia_tokens_prompt_caching", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ECONOMIA-TOKENS.md", "source_location": null, "weight": 1.0}, {"source": "docs_economia_tokens_economia_tokens", "target": "docs_economia_tokens_model_selection_by_task", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1