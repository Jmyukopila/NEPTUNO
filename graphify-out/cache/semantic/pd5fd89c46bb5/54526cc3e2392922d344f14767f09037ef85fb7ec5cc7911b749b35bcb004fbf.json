{"nodes": [{"id": "_claude_skills_graphify_references_query_query_reference", "label": "graphify Query, Path and Explain Reference", "file_type": "document", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_bfs_traversal", "label": "BFS traversal mode", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default mode: answers 'what is X connected to?' by exploring nearest neighbours layer by layer, depth 3."}, {"id": "_claude_skills_graphify_references_query_dfs_traversal", "label": "DFS traversal mode", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used for 'how does X reach Y?' \u2014 follows one chain deep, depth-limited to 6 so it does not traverse the whole graph."}, {"id": "_claude_skills_graphify_references_query_constrained_query_expansion", "label": "Constrained query expansion", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The query CLI matches labels by case-folded substring plus IDF with no stemming, synonyms or cross-language matching, so a literal mismatch returns zero hits and the answer collapses to noise. Expansion is constrained to the graph's own vocabulary to avoid inventing tokens."}, {"id": "_claude_skills_graphify_references_query_vocab_extraction", "label": "Node-label vocabulary extraction (.vocab.txt)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits camelCase/underscore label tokens into a 3-30 char vocabulary that expansion must draw from."}, {"id": "_claude_skills_graphify_references_query_auditable_expansion_output", "label": "Auditable printed token expansion", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Printing the selected tokens before traversal makes the expansion inspectable; an empty list stops the flow instead of fabricating a search."}, {"id": "_claude_skills_graphify_references_query_token_budget_output", "label": "Token-budget aware ranked output", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nodes are ranked by term overlap and the output truncated at ~4 chars/token so a query never floods the caller's context."}, {"id": "_claude_skills_graphify_references_query_graphify_path", "label": "graphify path (shortest path between concepts)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_graphify_explain", "label": "graphify explain (single node and neighbours)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_save_result_feedback_loop", "label": "save-result feedback loop", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persisting each answer back into the graph means the next --update extracts the Q&A as a node, so queries improve over time."}, {"id": "_claude_skills_graphify_references_query_work_memory_outcomes", "label": "Work memory outcomes (useful / dead_end / corrected)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Labelling outcomes lets future sessions start from preferred sources and skip known dead ends instead of re-deriving them."}, {"id": "_claude_skills_graphify_references_query_graphify_reflect_lessons", "label": "graphify reflect and LESSONS.md", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic, no-LLM reflection; --if-stale makes a session-start run nearly free when the git hook already refreshed the lessons."}, {"id": "_claude_skills_graphify_references_query_answer_only_from_graph", "label": "Answer only from what the graph contains", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents hallucinated edges: if the subgraph lacks the information, say so and cite source_location for every claim."}], "edges": [{"source": "_claude_skills_graphify_references_query_query_reference", "target": "_claude_skills_graphify_references_query_constrained_query_expansion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_query_reference", "target"