{"nodes": [{"id": "_claude_agents_debugger_debugger", "label": "Agente debugger (Opus)", "file_type": "document", "source_file": ".claude/agents/debugger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entrega la causa raiz DEMOSTRADA con evidencia, un fix minimo y un test de regresion. Nunca entrega una conjetura como diagnostico; un 'no lo se aun' honesto vale mas que un fix a ciegas."}, {"id": "_claude_agents_debugger_reproduce_primero", "label": "Reproduce primero", "file_type": "rationale", "source_file": ".claude/agents/debugger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si no reproduce, la tarea pasa a ser reproducirlo variando sistematicamente input, estado, orden y entorno. Prohibido diagnosticar de memoria."}, {"id": "_claude_agents_debugger_hipotesis_falsables", "label": "Biseccion con hipotesis falsables", "file_type": "rationale", "source_file": ".claude/agents/debugger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cada hipotesis se formula como 'X hace Y cuando Z' y se disena la observacion mas barata que la confirme o la mate; una variable por experimento, con registro de cada hipotesis descartada y su evidencia. Incluye debugging diferencial entre un caso que funciona y otro que falla, y reproduccion estadistica para heisenbugs."}, {"id": "_claude_agents_debugger_causa_explica_100_del_sintoma", "label": "La causa debe explicar el 100% del sintoma", "file_type": "rationale", "source_file": ".claude/agents/debugger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si la candidata no explica todos los detalles observados (frecuencia, condiciones, mensaje exacto), la causa es otra. Evita cerrar un bug con una explicacion parcial que deja el fallo real vivo."}, {"id": "_claude_agents_debugger_radio_de_explosion", "label": "Medir el radio de explosion del patron defectuoso", "file_type": "rationale", "source_file": ".claude/agents/debugger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grep por el patron defectuoso: si el mismo bug existe en otros sitios, se reportan todos en vez de parchear solo la instancia observada."}], "edges": [{"source": "_claude_agents_debugger_debugger", "target": "_claude_agents_debugger_reproduce_primero", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/debugger.md", "source_location": null, "weight": 1.0}, {"source": "_claude_agents_debugger_debugger", "target": "_claude_agents_debugger_hipotesis_falsables", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/debugger.md", "source_location": null, "weight": 1.0}, {"source": "_claude_agents_debugger_debugger", "target": "_claude_agents_debugger_causa_explica_100_del_sintoma", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/debugger.md", "source_location": null, "weight": 1.0}, {"source": "_claude_agents_debugger_debugger", "target": "_claude_agents_debugger_radio_de_explosion", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/debugger.md", "source_location": null, "weight": 1.0}, {"source": "_claude_agents_debugger_reproduce_primero", "target": "claude_honestidad_de_resultados", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/debugger.md", "source_location": null, "weight": 1.0}, {"source": "_claude_agents_debugger_radio_de_explosion", "target": "_claude_agents_scout_scout", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file