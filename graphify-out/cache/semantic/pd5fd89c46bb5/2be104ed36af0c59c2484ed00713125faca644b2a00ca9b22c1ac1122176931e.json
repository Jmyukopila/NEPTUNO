, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Degradado morado-azul, sombra difusa id\u00e9ntica en cada tarjeta, combo Inter+Poppins, iconos sin curar, border-radius uniforme y max-w-md mx-auto como layout por defecto."}, {"id": "_claude_skills_frontend_design_skill_decide_dont_ask", "label": "Decidir la direcci\u00f3n en vez de preguntar el gusto", "file_type": "rationale", "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si no hay direcci\u00f3n dada ni establecida, se decide una y se declara; solo se pregunta ante ambig\u00fcedad real de producto (B2B serio vs consumer l\u00fadico)."}], "edges": [{"source": "_claude_skills_frontend_design_skill_frontend_design", "target": "_claude_skills_frontend_design_skill_character_sentence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_frontend_design_skill_frontend_design", "target": "_claude_skills_frontend_design_skill_design_direction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_frontend_design_skill_frontend_design", "target": "_claude_skills_frontend_design_skill_real_references", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/frontend-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_frontend_design_skill_frontend_design", "target": "_claude_skills_frontend_design_skill_ai_look_antipatterns", "relation": "references", "confidence": "EXTRACTED", "confidenc