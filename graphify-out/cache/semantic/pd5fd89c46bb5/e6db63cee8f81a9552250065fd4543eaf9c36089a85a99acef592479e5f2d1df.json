{"nodes": [{"id": "_claude_skills_motion_design_skill_motion_design_skill", "label": "motion-design skill", "file_type": "document", "source_file": ".claude/skills/motion-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_motion_design_skill_duration_scale", "label": "Declared duration scale", "file_type": "rationale", "source_file": ".claude/skills/motion-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Micro 100-150ms, state 200-300ms, page 300-500ms; beyond 500ms for something the user is actively waiting on reads as slow, not elegant."}, {"id": "_claude_skills_motion_design_skill_easing_curves", "label": "Easing curve set (entry, exit, loop)", "file_type": "rationale", "source_file": ".claude/skills/motion-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entries ease out so they land softly, exits ease in so they feel responsive; linear is never used for user-perceptible movement."}, {"id": "_claude_skills_motion_design_skill_transform_opacity_only", "label": "Animate only transform and opacity", "file_type": "rationale", "source_file": ".claude/skills/motion-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They are the only properties the browser can animate on the compositor layer without recalculating layout or paint, so animating width/height/top/box-shadow in loops causes jank."}, {"id": "_claude_skills_motion_design_skill_proportional_stagger", "label": "Proportional stagger delay", "file_type": "rationale", "source_file": ".claude/skills/motion-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "delay = index * min(50ms, 400ms / count) keeps a list from getting slower as it grows, unlike a fixed per-item delay."}, {"id": "_claude_skills_motion_design_skill_prefers_reduced_motion", "label": "prefers-reduced-motion fallback", "file_type": "rationale", "source_file": ".claude/skills/motion-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-essential animation is disabled or drastically reduced, keeping only instant opacity changes for state feedback."}, {"id": "_claude_skills_motion_design_skill_motion_with_intent", "label": "Motion with semantic intent", "file_type": "rationale", "source_file": ".claude/skills/motion-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Movement communicates hierarchy and causality; animating everything with one curve is as generic as animating nothing."}], "edges": [{"source": "_claude_skills_motion_design_skill_motion_design_skill", "target": "_claude_skills_motion_design_skill_duration_scale", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/motion-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_motion_design_skill_motion_design_skill", "target": "_claude_skills_motion_design_skill_easing_curves", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/motion-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_motion_design_skill_duration_scale", "target": "_claude_skills_motion_design_skill_easing_curves", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/motion-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_motion_design_skill_motion_design_skill", "target": "_claude_skills_motion_design_skill_transform_