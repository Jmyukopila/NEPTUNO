{"nodes": [{"id": "_claude_skills_editorial_layout_skill_editorial_layout", "label": "Skill /editorial-layout", "file_type": "document", "source_file": ".claude/skills/editorial-layout/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El instinto por defecto de un modelo es meter cada bloque en una tarjeta con borde y sombra; el dise\u00f1o editorial usa ret\u00edcula y tipograf\u00eda para crear jerarqu\u00eda."}, {"id": "_claude_skills_editorial_layout_skill_grid_first", "label": "Ret\u00edcula antes del contenido", "file_type": "rationale", "source_file": ".claude/skills/editorial-layout/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El contenido se alinea a la ret\u00edcula, no al rev\u00e9s; 12 columnas es el est\u00e1ndar y 4-6 para layouts densos de texto."}, {"id": "_claude_skills_editorial_layout_skill_typographic_scale", "label": "Escala tipogr\u00e1fica estricta", "file_type": "rationale", "source_file": ".claude/skills/editorial-layout/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Elegir una raz\u00f3n (1.25, 1.333, 1.5) y derivar TODOS los tama\u00f1os de un valor base, para que no convivan 14/15/17px sin motivo."}, {"id": "_claude_skills_editorial_layout_skill_typographic_contrast", "label": "Contraste tipogr\u00e1fico como jerarqu\u00eda", "file_type": "rationale", "source_file": ".claude/skills/editorial-layout/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Titular grande + peso alto junto a cuerpo peque\u00f1o comunica jerarqu\u00eda sin necesitar fondos ni bordes distintos."}, {"id": "_claude_skills_editorial_layout_skill_contained_palette", "label": "Paleta contenida", "file_type": "rationale", "source_file": ".claude/skills/editorial-layout/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Los grises intermedios se generan variando luminosidad del mismo tono, no a\u00f1adiendo grises neutros sueltos."}, {"id": "_claude_skills_editorial_layout_skill_whitespace_as_content", "label": "El espacio en blanco es contenido", "file_type": "rationale", "source_file": ".claude/skills/editorial-layout/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Antes de envolver un bloque en una tarjeta, separarlo solo con espacio y una regla tipogr\u00e1fica; las tarjetas se reservan para agrupar elementos heterog\u00e9neos de verdad."}, {"id": "_claude_skills_editorial_layout_skill_vertical_rhythm", "label": "Ritmo vertical sistem\u00e1tico", "file_type": "rationale", "source_file": ".claude/skills/editorial-layout/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El espaciado entre bloques sigue la misma escala (m\u00faltiplos de 4/8) que la tipograf\u00eda, no valores arbitrarios por bloque."}, {"id": "_claude_skills_editorial_layout_skill_card_antipattern", "label": "Anti-patr\u00f3n de la tarjeta por costumbre", "file_type": "rationale", "source_file": ".claude/skills/editorial-layout/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Envolver cada secci\u00f3n en div.card shadow rounded-lg p-6, centrar texto largo (>60-75 caracteres rompe legibilidad) y usar bordes de color aleatorio son los defaults a evitar."}], "edges": [{"source": "_claude_skills_editorial_layout_skill_editorial_layout", "target": "_claude_skills_editorial_layout_skill_grid_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/editorial-layout/SKILL.md", "source_locatio