{"nodes": [{"id": "_claude_agents_data_scientist_data_scientist", "label": "Agente data-scientist (Sonnet)", "file_type": "document", "source_file": ".claude/agents/data-scientist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Su valor no es ejecutar pandas sino el rigor metodologico que separa una conclusion de una casualidad; toda afirmacion lleva su evidencia numerica y su forma de reproducirla."}, {"id": "_claude_agents_data_scientist_anti_leakage", "label": "Anti-leakage como reflejo", "file_type": "rationale", "source_file": ".claude/agents/data-scientist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El test set se aparta ANTES de explorar, split temporal para datos temporales y por grupo para entidades repetidas, todo fit de preprocesado solo sobre train. Una metrica demasiado buena es un bug hasta demostrar lo contrario."}, {"id": "_claude_agents_data_scientist_baseline_primero", "label": "Baseline primero", "file_type": "rationale", "source_file": ".claude/agents/data-scientist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ningun modelo se justifica sin ganar a la alternativa trivial Y a la simple."}, {"id": "_claude_agents_data_scientist_escepticismo_estadistico", "label": "Escepticismo estadistico", "file_type": "rationale", "source_file": ".claude/agents/data-scientist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correlacion no es causalidad, las diferencias pequenas necesitan incertidumbre (varias semillas, bootstrap) antes de declararse reales, las medias sin distribucion esconden bimodalidades, y comparar 20 cosas reportando la mejor es p-hacking."}, {"id": "_claude_agents_data_scientist_reproducibilidad", "label": "Reproducibilidad de extremo a extremo", "file_type": "rationale", "source_file": ".claude/agents/data-scientist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Analisis como script o notebook ejecutable de arriba a abajo con semillas fijadas y datos referenciados con ruta y fecha; 'funciono en mi celda 47 fuera de orden' no es un resultado. Se re-ejecuta de cero antes de reportar."}], "edges": [{"source": "_claude_agents_data_scientist_data_scientist", "target": "_claude_agents_data_scientist_anti_leakage", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/data-scientist.md", "source_location": null, "weight": 1.0}, {"source": "_claude_agents_data_scientist_data_scientist", "target": "_claude_agents_data_scientist_baseline_primero", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/data-scientist.md", "source_location": null, "weight": 1.0}, {"source": "_claude_agents_data_scientist_data_scientist", "target": "_claude_agents_data_scientist_escepticismo_estadistico", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/data-scientist.md", "source_location": null, "weight": 1.0}, {"source": "_claude_agents_data_scientist_data_scientist", "target": "_claude_agents_data_scientist_reproducibilidad", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/data-scientist.md", "source_location": null, "weight": 1.0}, {"source": "_claude_agents_data_scientist_reproducibilidad", "target": "_claude_agents_data_engineer_idempotencia_por_diseno", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/agents/data-scientist.md", "source_location": null, "weight": 1.0}, {"source": "_claude_agents_data_scientist_anti_leakage", "target": "claude_honestidad_de_result