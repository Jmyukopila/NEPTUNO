inar", "file_type": "rationale", "source_file": ".claude/skills/desktop-run/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un npm run dev colgado en background bloquea el puerto/handle para la siguiente sesi\u00f3n de trabajo."}], "edges": [{"source": "_claude_skills_desktop_run_skill_desktop_run", "target": "_claude_skills_desktop_run_skill_framework_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/desktop-run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_desktop_run_skill_desktop_run", "target": "_claude_skills_desktop_run_skill_background_log_capture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/desktop-run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_desktop_run_skill_desktop_run", "target": "_claude_skills_desktop_run_skill_startup_verdict", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/desktop-run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_desktop_run_skill_desktop_run", "target": "_claude_skills_desktop_run_skill_process_cleanup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/desktop-run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_desktop_run_skill_desktop_run", "target": "_claude_skills_desktop_release_skill_desktop_release", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/desktop-run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_desktop_run_skill_framework_detection", "target": "_claude_skills_desktop_release_skill_version_bump", "relation": "conceptually_related_to", "confidence": "INFERRED"