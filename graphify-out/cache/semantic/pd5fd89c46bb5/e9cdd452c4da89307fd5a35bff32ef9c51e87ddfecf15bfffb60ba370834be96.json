{"nodes": [{"id": "_claude_skills_expo_doctor_skill_expo_doctor", "label": "Skill /expo-doctor", "file_type": "document", "source_file": ".claude/skills/expo-doctor/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audita las piezas de las que depende cualquier proyecto Expo en orden de dependencia; no duplica /android-doctor, cubre la capa Expo/JS por encima."}, {"id": "_claude_skills_expo_doctor_skill_node_version_check", "label": "Versi\u00f3n de Node vs m\u00ednimo del SDK", "file_type": "rationale", "source_file": ".claude/skills/expo-doctor/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un Node m\u00e1s viejo que el m\u00ednimo del SDK instalado es la causa n\u00ba1 de fallos raros de instalaci\u00f3n/build."}, {"id": "_claude_skills_expo_doctor_skill_npx_expo_doctor", "label": "Chequeo oficial npx expo-doctor", "file_type": "rationale", "source_file": ".claude/skills/expo-doctor/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Valida versiones de paquetes contra el React Native Directory y la sincron\u00eda entre app.json/package.json y la config nativa."}, {"id": "_claude_skills_expo_doctor_skill_expo_install_check", "label": "npx expo install --check", "file_type": "rationale", "source_file": ".claude/skills/expo-doctor/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conoce la matriz de compatibilidad real del SDK; un npm update gen\u00e9rico puede saltarse a versiones no soportadas y reescribir package.json a mano es peor."}, {"id": "_claude_skills_expo_doctor_skill_eas_cli_session", "label": "CLI y sesi\u00f3n de EAS", "file_type": "rationale", "source_file": ".claude/skills/expo-doctor/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El CLI de Expo va empaquetado con el proyecto (npx expo), pero el de EAS es global; sin sesi\u00f3n, los perfiles no locales de /expo-build y /expo-release fallan."}, {"id": "_claude_skills_expo_doctor_skill_native_config_sync", "label": "Config nativa sincronizada con app.json", "file_type": "rationale", "source_file": ".claude/skills/expo-doctor/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si hay desincron\u00eda y el equipo no edita nativo a mano, npx expo prebuild --clean es la cura."}, {"id": "_claude_skills_expo_doctor_skill_watchman_na_windows", "label": "Watchman no aplica en Windows", "file_type": "rationale", "source_file": ".claude/skills/expo-doctor/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Metro usa su propio watcher basado en Node en Windows; si no detecta cambios, sospechar de rutas con caracteres especiales o antivirus, nunca de Watchman."}], "edges": [{"source": "_claude_skills_expo_doctor_skill_expo_doctor", "target": "_claude_skills_expo_doctor_skill_node_version_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/expo-doctor/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_expo_doctor_skill_expo_doctor", "target": "_claude_skills_expo_doctor_skill_npx_expo_doctor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/expo-doctor/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_expo_doctor_skill_expo_doctor", "target": "_claude_skills_expo_doctor_skill_expo_install_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/expo-doctor/SKILL.md", "source_location": null, "weight