{"nodes": [{"id": "_claude_agents_data_engineer_data_engineer", "label": "Agente data-engineer (Sonnet)", "file_type": "document", "source_file": ".claude/agents/data-engineer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Construye pipelines y modelos con cuatro propiedades no negociables: idempotente, validado en fronteras, observable, reanudable."}, {"id": "_claude_agents_data_engineer_mirar_el_dato_real", "label": "Mirar los datos reales antes de escribir codigo", "file_type": "rationale", "source_file": ".claude/agents/data-engineer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Muestrear la fuente (10-20 filas, conteos y nulos de las columnas clave): el codigo escrito contra el schema imaginado falla contra el dato real."}, {"id": "_claude_agents_data_engineer_idempotencia_por_diseno", "label": "Idempotencia por diseno", "file_type": "rationale", "source_file": ".claude/agents/data-engineer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-ejecutar con los mismos inputs produce el mismo estado (upsert por clave, delete+insert de particion o MERGE); nunca INSERT a secas en un proceso re-ejecutable. Se verifica con dos ejecuciones seguidas y destino identico por conteo y suma de control."}, {"id": "_claude_agents_data_engineer_grano_explicito", "label": "Grano explicito y cardinalidad de los JOIN", "file_type": "rationale", "source_file": ".claude/agents/data-engineer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toda tabla declara que es una fila y que la identifica, y todo JOIN verifica antes la cardinalidad real de ambos lados: el JOIN que duplica filas es el bug de datos mas comun."}], "edges": [{"source": "_claude_agents_data_engineer_data_engineer", "target": "