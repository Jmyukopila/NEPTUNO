{"nodes": [{"id": "_claude_skills_generative_art_skill_generative_art", "label": "Skill /generative-art", "file_type": "document", "source_file": ".claude/skills/generative-art/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un fondo generativo bien elegido es m\u00e1s original y m\u00e1s ligero que cualquier imagen de stock: se codifica, no se descarga."}, {"id": "_claude_skills_generative_art_skill_noise_fields", "label": "Campos de ruido Perlin/Simplex", "file_type": "rationale", "source_file": ".claude/skills/generative-art/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fondos org\u00e1nicos tipo 'nube de tinta', encajan con direcciones n\u00f3rdicas/org\u00e1nicas."}, {"id": "_claude_skills_generative_art_skill_particle_systems", "label": "Sistemas de part\u00edculas", "file_type": "rationale", "source_file": ".claude/skills/generative-art/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "F\u00edsica simple de atracci\u00f3n/repulsi\u00f3n al cursor; encajan con direcciones t\u00e9cnicas o retro-futuristas."}, {"id": "_claude_skills_generative_art_skill_flow_fields", "label": "Flow fields", "file_type": "rationale", "source_file": ".claude/skills/generative-art/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Part\u00edculas siguiendo un campo vectorial derivado de ruido: buen fondo ambiental de baja distracci\u00f3n."}, {"id": "_claude_skills_generative_art_skill_geometric_tessellation", "label": "Teselaci\u00f3n geom\u00e9trica (Voronoi, Truchet)", "file_type": "rationale", "source_file": ".claude/skills/generative-art/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Or