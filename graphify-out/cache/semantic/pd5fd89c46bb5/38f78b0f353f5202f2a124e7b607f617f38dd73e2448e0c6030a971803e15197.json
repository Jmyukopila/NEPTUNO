{"nodes": [{"id": "_claude_skills_pr_stack_skill_pr_stack_skill", "label": "pr-stack skill (stacked PRs)", "file_type": "document", "source_file": ".claude/skills/pr-stack/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_pr_stack_skill_stacked_branch_chain", "label": "Chained branches with PR bases", "file_type": "rationale", "source_file": ".claude/skills/pr-stack/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each PR's base is the previous branch, so GitHub shows only the incremental diff: several 200-line PRs reviewable in minutes instead of one of 2000."}, {"id": "_claude_skills_pr_stack_skill_each_layer_standalone", "label": "Each layer leaves the repo working", "file_type": "rationale", "source_file": ".claude/skills/pr-stack/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stack layer that cannot compile and pass tests on its own is merged into its neighbour."}, {"id": "_claude_skills_pr_stack_skill_restack_update_refs", "label": "restack with git rebase --update-refs", "file_type": "rationale", "source_file": ".claude/skills/pr-stack/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebases the whole chain moving every intermediate branch in one command; requires git >= 2.38, otherwise rebase layer by layer."}, {"id": "_claude_skills_pr_stack_skill_land_in_order", "label": "Land the stack bottom-up with retargeting", "file_type": "rationale", "source_file": ".claude/skills/pr-stack/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After merging the bottom PR the next one points at a deleted branch \u2014 GitHub sometimes retargets automatically, so verify rat