{"nodes": [{"id": "_claude_skills_expo_build_skill_expo_build", "label": "Skill /expo-build", "file_type": "document", "source_file": ".claude/skills/expo-build/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hay dos caminos y no son intercambiables: build local (Gradle en esta m\u00e1quina, solo Android) y build EAS (en la nube). Se elige antes de compilar, no a mitad de camino."}, {"id": "_claude_skills_expo_build_skill_local_android_build", "label": "Build local Android (expo run:android)", "file_type": "rationale", "source_file": ".claude/skills/expo-build/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Por debajo corre Gradle igual que un proyecto Android nativo; si falla por JDK/SDK/licencias es terreno de /android-doctor, no de Metro."}, {"id": "_claude_skills_expo_build_skill_eas_build", "label": "EAS Build en la nube", "file_type": "rationale", "source_file": ".claude/skills/expo-build/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No consume CPU local pero s\u00ed cola de espera; con --no-wait se sigue trabajando y se comprueba despu\u00e9s con eas build:list / eas build:view."}, {"id": "_claude_skills_expo_build_skill_eas_profiles", "label": "Perfiles de eas.json", "file_type": "rationale", "source_file": ".claude/skills/expo-build/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si el usuario pide 'preview' y ese perfil no existe, hay que avisar, no inventar uno silenciosamente."}, {"id": "_claude_skills_expo_build_skill_ios_windows_limitation", "label": "iOS local imposible en Windows", "file_type": "rationale", "source_file": ".claude/skills/expo-build/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "expo run:ios requiere Xcode/macOS; en Windows iOS SIEMPRE pasa por eas build --platform ios. No intentarlo local ni prometerlo."}, {"id": "_claude_skills_expo_build_skill_prebuild_sync", "label": "Sincron\u00eda de prebuild", "file_type": "rationale", "source_file": ".claude/skills/expo-build/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instalar una librer\u00eda nativa sin regenerar android/ios produce 'Native module cannot be null'; la cura es npx expo prebuild --clean y rebuild."}, {"id": "_claude_skills_expo_build_skill_token_rule_log_filtering", "label": "Regla de tokens: filtrar el log de build", "file_type": "rationale", "source_file": ".claude/skills/expo-build/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redirigir el output a un archivo del scratchpad y mostrar solo las \u00faltimas ~20 l\u00edneas o el error filtrado por error/FAILURE/Caused by."}, {"id": "_claude_skills_expo_build_skill_finished_state_rule", "label": "Nunca declarar \u00e9xito sin estado finished", "file_type": "rationale", "source_file": ".claude/skills/expo-build/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un build EAS 'en cola' o 'in progress' no es un build exitoso."}], "edges": [{"source": "_claude_skills_expo_build_skill_expo_build", "target": "_claude_skills_expo_build_skill_local_android_build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/expo-build/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_expo_build_skill_expo_build", "target": "_claude_skills_expo_build_skill_eas_build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/expo-build/SKI