{"nodes": [{"id": "_claude_skills_responsive_grid_skill_responsive_grid_skill", "label": "responsive-grid skill", "file_type": "document", "source_file": ".claude/skills/responsive-grid/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_responsive_grid_skill_continuous_scaling", "label": "Continuous scaling over fixed breakpoints", "file_type": "rationale", "source_file": ".claude/skills/responsive-grid/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Traditional breakpoints produce discrete jumps (16px until 768px then suddenly 20px); continuous scaling removes the jump and reduces the number of rules to maintain."}, {"id": "_claude_skills_responsive_grid_skill_clamp_fluid_values", "label": "clamp() for fluid typography and spacing", "file_type": "rationale", "source_file": ".claude/skills/responsive-grid/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_responsive_grid_skill_vmax_vmin_proportion", "label": "vmax / vmin for viewport-dominant proportion", "file_type": "rationale", "source_file": ".claude/skills/responsive-grid/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More robust than vw alone, which breaks on very wide, short ultrawide screens."}, {"id": "_claude_skills_responsive_grid_skill_container_queries", "label": "Container queries for reusable components", "file_type": "rationale", "source_file": ".claude/skills/responsive-grid/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A component reused at 300px in a sidebar and 800px in a grid must respond to its container, not the global viewport."}, {"id": "_claude_skills_responsive_grid_skill_breakpoi